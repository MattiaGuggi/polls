{
  "name": "polls",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"APP,STUDIO\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:app\" \"npm run db:studio\"",
    "dev:app": "next dev",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/db/migrate.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint && drizzle-kit check"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-icons": "^1.3.2",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.23.3",
    "gsap": "^3.13.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "next": "15.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "24.0.13",
    "@types/react": "19.1.8",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
